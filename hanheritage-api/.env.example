# 复制为 .env 后按实际环境填写；.env 含真实密码，禁止提交到仓库。

# ===== 服务端口 =====
# 后端监听端口，Nginx 将 /api 与 /uploads 反向代理到此端口
PORT=3083

# ===== MySQL 连接串（Prisma） =====
# 生产环境请使用独立的最小权限账号，不要直接使用 root
DATABASE_URL="mysql://user:password@127.0.0.1:3306/han_coffin_db"

# ===== JWT 认证 =====
# 生产环境务必替换为随机值（建议 >= 32 位），不可沿用默认值
JWT_SECRET="replace-with-a-random-secret"
JWT_EXPIRES_IN="2h"

# ===== Redis（可选） =====
# 仅系统监控/Redis 信息页使用；未部署 Redis 时相关页面提示不可用，不影响主流程
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
